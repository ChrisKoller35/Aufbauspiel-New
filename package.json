{
  "name": "magic-city",
  "version": "0.2.0",
  "description": "Magic City – Fantasy City Builder + RPG Expeditions (HTML UI)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "generate-sprites": "npx tsx tools/generateSprites.ts",
    "resize-sprites": "npx tsx tools/resizeSprites.ts",
    "remove-bg": "npx tsx tools/removeBg.ts",
    "generate-sounds": "npx tsx tools/generateSounds.ts",
    "generate-all": "npx tsx tools/generateSprites.ts && npx tsx tools/resizeSprites.ts && npx tsx tools/removeBg.ts && npx tsx tools/generateSounds.ts",
    "sprite-check": "npx tsx tools/spriteCheck.ts",
    "sprite-fix": "npx tsx tools/spriteCheck.ts --fix",
    "second-opinion": "npx tsx tools/geminiSecondOpinion.ts",
    "composite-item": "npx tsx tools/compositeItem.ts",
    "crop-icons": "npx tsx tools/cropAndScaleIcons.ts",
    "cut-weapon-sheet": "npx tsx tools/cutWeaponSheet.ts",
    "validate-refs": "npx tsx tools/validateRefs.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0",
    "sharp": "^0.33.0",
    "sharp-cli": "^5.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {}
}

{
  "name": "magic-city",
  "version": "0.1.0",
  "description": "Magic City – Fantasy City Builder + RPG Expeditions",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate-sprites": "npx tsx tools/generateSprites.ts",
    "resize-sprites": "npx tsx tools/resizeSprites.ts",
    "remove-bg": "npx tsx tools/removeBg.ts",
    "generate-sounds": "npx tsx tools/generateSounds.ts",
    "generate-all": "npx tsx tools/generateSprites.ts && npx tsx tools/resizeSprites.ts && npx tsx tools/removeBg.ts && npx tsx tools/generateSounds.ts",
    "sprite-check": "npx tsx tools/spriteCheck.ts",
    "sprite-fix": "npx tsx tools/spriteCheck.ts --fix",
    "second-opinion": "npx tsx tools/geminiSecondOpinion.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0",
    "phaser": "^3.90.0",
    "sharp": "^0.33.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.1"
  }
}
